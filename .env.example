# ── Local development ──────────────────────────────────────────────
# FastAPI RAG chat base URL (no trailing slash).
# Leave empty (or omit) to use the built-in local knowledge fallback.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Contact form destination inbox
CONTACT_TO_EMAIL=you@example.com

# Optional but recommended: Gmail SMTP for reliable contact delivery
# 1) Google Account → Security → 2-Step Verification ON
# 2) App passwords → create one for Mail
# 3) Paste the 16-character password (spaces OK)
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=

# ── Hostinger production (hPanel → Node.js / Web App → Environment) ─
# CONTACT_TO_EMAIL      = your inbox
# GMAIL_USER            = your Gmail address
# GMAIL_APP_PASSWORD    = Gmail App Password
# NEXT_PUBLIC_API_URL   = leave empty until RAG has a public HTTPS URL
#                         (Ask AI uses local portfolio knowledge)
#
# Hostinger build settings (SSR — required for /api/contact):
#   Node: 20 | Build: npm run build | Output: .next
#   Start: npm run start -- -p $PORT

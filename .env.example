# Contact form destination inbox
CONTACT_TO_EMAIL=you@example.com

# Optional but recommended: Gmail SMTP for reliable contact delivery
# 1) Google Account → Security → 2-Step Verification ON
# 2) App passwords → create one for Mail
# 3) Paste the 16-character password (spaces OK)
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=

# Optional: external FastAPI RAG (server-side only). Leave empty on Hostinger
# unless the RAG API has a public HTTPS URL. Ask AI always works via /api/chat
# with local portfolio knowledge when this is empty or localhost.
# API_URL=https://your-rag-api.example.com
#
# Local only — ignored in production chat route:
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Hostinger (hPanel → Node.js Web App → Environment) ─────────────
# CONTACT_TO_EMAIL / GMAIL_USER / GMAIL_APP_PASSWORD = set these
# NEXT_PUBLIC_API_URL / API_URL = leave empty (Ask AI uses /api/chat)
#
# Build: Node 20 | npm run build | Output .next
# Start: npm run start -- -p $PORT
